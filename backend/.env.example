PORT=3000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=smart_monitoring
JWT_SECRET=change-this-secret
# Comma-separated production browser origins. Required when NODE_ENV=production.
CORS_ORIGINS=https://analytics.smartmonitoringsystem.store
API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.smartmonitoringsystem.store/api/auth/google/callback
WEB_ANALYTICS_URL=https://analytics.smartmonitoringsystem.store
# Legacy callback settings for mobile clients, if still used.
GOOGLE_REDIRECT_URI=
GOOGLE_BACKEND_REDIRECT_URI=
GOOGLE_OAUTH_REDIRECT_URI=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend is used for outbound system email over HTTPS, which works on DigitalOcean.
RESEND_API_KEY=re_replace_with_your_private_sending_key
FROM_EMAIL=Smart Monitoring System <noreply@mail.smartmonitoringsystem.store>
